# ==========================================
# LOVRARY - VARIÁVEIS DE AMBIENTE (Vercel & Local)
# ==========================================

# 1. Supabase (URL do seu projeto Supabase)
VITE_SUPABASE_URL=https://seu-projeto-supabase.supabase.co

# 2. Supabase Anon Key (Chave pública anônima)
# Dica: O código suporta tanto VITE_SUPABASE_ANON_KEY quanto VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# 3. Google Books API Key (Gratuita no Google Cloud Console - APIs & Services > Credentials)
VITE_GOOGLE_BOOKS_API_KEY=sua_chave_api_do_google_books_aqui