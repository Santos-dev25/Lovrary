# Supabase - Obrigatório para autenticação e sincronização
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Google Books API - OPCIONAL (Apenas para desenvolvimento local sem Edge Function)
# Em produção (Vercel), a busca passa com segurança pela Edge Function do Supabase.
# Cadastre GOOGLE_BOOKS_API_KEY nos Secrets do Supabase (Project Settings > Edge Functions).
VITE_GOOGLE_BOOKS_API_KEY=sua-chave-google-aqui